<mujoco model="infantry_V4_serial">
  <!-- Nominal MuJoCo counterpart of the Isaac Gym infantry_V4_increase URDF. -->
  <compiler angle="radian" balanceinertia="true"
            meshdir="../../../../plane/resources/robots/infantry_V4/meshes"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="100"/>

  <default>
    <joint armature="0" damping="0" frictionloss="0"/>
    <!-- PhysX restitution=0.5 is approximated by an under-damped MuJoCo contact. -->
    <geom contype="1" conaffinity="1" condim="3" friction="0.5 0 0" solref="0.02 0.21545"/>
  </default>

  <asset>
    <mesh name="base_link_mesh" file="base_link.STL"/>
    <mesh name="rf0_mesh" file="rf0_Link.STL"/>
    <mesh name="rf1_mesh" file="rf1_Link.STL"/>
    <mesh name="r_wheel_mesh" file="r_wheel_Link.STL"/>
    <mesh name="lf0_mesh" file="lf0_Link.STL"/>
    <mesh name="lf1_mesh" file="lf1_Link.STL"/>
    <mesh name="l_wheel_mesh" file="l_wheel_Link.STL"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="40 40 0.1" contype="1" conaffinity="1"
          friction="0.5 0 0" rgba="0.65 0.65 0.65 1"/>

    <body name="base_link" pos="0 0 0.2">
      <freejoint/>
      <inertial pos="-0.00406060 0.0008523 0.097142"
                mass="16.8775740"
                fullinertia="0.3595155 0.35249 0.45655 -0.00174358 -0.00825907 -0.00214156"/>
      <site name="imu_site" pos="0 0 0" size="0.005"/>
      <geom name="base_geom" type="mesh" mesh="base_link_mesh" rgba="1 1 1 1"/>

      <!-- Right serial chain. The order matches the URDF and Isaac DOF tensor. -->
      <body name="rf0_Link" pos="0 -0.1877 0.08725" euler="1.5708 0 0">
        <inertial pos="0.05527628 -0.01655437 -0.00927161" mass="1.1132"
                  fullinertia="0.00207047 0.00467389 0.00640479 -0.00022911 -0.00015432 0.00011008"/>
        <joint name="rf0_Joint" type="hinge" axis="0 0 1" limited="true"
               range="-100 100" actuatorfrcrange="-50 50"/>
        <geom type="mesh" mesh="rf0_mesh" rgba="1 1 1 1"/>
        <body name="rf1_Link" pos="0.17472 0 0">
          <inertial pos="-0.00283459 -0.07106759 0.0068255" mass="0.3068726"
                    fullinertia="0.00247367 0.00009262 0.00253997 0.0001249 -0.00000342 0.00003434"/>
          <joint name="rf1_Joint" type="hinge" axis="0 0 1" limited="true"
                 range="-1.1 0.65" actuatorfrcrange="-50 50"/>
          <geom type="mesh" mesh="rf1_mesh" rgba="1 1 1 1"/>
          <body name="r_wheel_Link" pos="0 -0.208 0.016">
            <inertial pos="0.0000043469 -0.00019294 0.019568" mass="0.49069"
                      fullinertia="0.00033972 0.00034147 0.00068188 0 0.00000003 -0.00000152"/>
            <joint name="r_wheel_Joint" type="hinge" axis="0 0 1"
                   actuatorfrcrange="-5 5"/>
            <geom type="mesh" mesh="r_wheel_mesh" rgba="0.18 0.18 0.18 1"/>
          </body>
        </body>
      </body>

      <!-- Left serial chain. -->
      <body name="lf0_Link" pos="0 0.1877 0.08725" euler="-1.5708 0 0">
        <inertial pos="0.055403 0.016584 -0.0092702" mass="1.1128"
                  fullinertia="0.00207221 0.00466506 0.00639795 0.00022396 -0.00015529 -0.00011027"/>
        <joint name="lf0_Joint" type="hinge" axis="0 0 1" limited="true"
               range="-100 100" actuatorfrcrange="-50 50"/>
        <geom type="mesh" mesh="lf0_mesh" rgba="1 1 1 1"/>
        <body name="lf1_Link" pos="0.17472 0 0">
          <inertial pos="-0.0028358 0.071068 0.0068255" mass="0.30687"
                    fullinertia="0.00247367 0.00009262 0.00253997 -0.0001249 -0.00000342 -0.00003434"/>
          <joint name="lf1_Joint" type="hinge" axis="0 0 1" limited="true"
                 range="-0.65 1.1" actuatorfrcrange="-50 50"/>
          <geom type="mesh" mesh="lf1_mesh" rgba="1 1 1 1"/>
          <body name="l_wheel_Link" pos="0 0.208 0.016">
            <inertial pos="-0.0000043477 0.00019294 0.019568" mass="0.49069"
                      fullinertia="0.00033972 0.00034147 0.00068188 0 -0.00000003 0.00000152"/>
            <joint name="l_wheel_Joint" type="hinge" axis="0 0 1"
                   actuatorfrcrange="-5 5"/>
            <geom type="mesh" mesh="l_wheel_mesh" rgba="0.18 0.18 0.18 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="act_rf0" joint="rf0_Joint" gear="1" ctrllimited="true" ctrlrange="-50 50"/>
    <motor name="act_rf1" joint="rf1_Joint" gear="1" ctrllimited="true" ctrlrange="-50 50"/>
    <motor name="act_rw" joint="r_wheel_Joint" gear="1" ctrllimited="true" ctrlrange="-5 5"/>
    <motor name="act_lf0" joint="lf0_Joint" gear="1" ctrllimited="true" ctrlrange="-50 50"/>
    <motor name="act_lf1" joint="lf1_Joint" gear="1" ctrllimited="true" ctrlrange="-50 50"/>
    <motor name="act_lw" joint="l_wheel_Joint" gear="1" ctrllimited="true" ctrlrange="-5 5"/>
  </actuator>

  <sensor>
    <framequat name="orientation" objtype="body" objname="base_link"/>
    <gyro name="base_ang_vel" site="imu_site"/>
    <accelerometer name="base_lin_acc" site="imu_site"/>
    <jointpos name="rf0_Joint_p" joint="rf0_Joint"/>
    <jointvel name="rf0_Joint_v" joint="rf0_Joint"/>
    <jointpos name="rf1_Joint_p" joint="rf1_Joint"/>
    <jointvel name="rf1_Joint_v" joint="rf1_Joint"/>
    <jointpos name="r_wheel_Joint_p" joint="r_wheel_Joint"/>
    <jointvel name="r_wheel_Joint_v" joint="r_wheel_Joint"/>
    <jointpos name="lf0_Joint_p" joint="lf0_Joint"/>
    <jointvel name="lf0_Joint_v" joint="lf0_Joint"/>
    <jointpos name="lf1_Joint_p" joint="lf1_Joint"/>
    <jointvel name="lf1_Joint_v" joint="lf1_Joint"/>
    <jointpos name="l_wheel_Joint_p" joint="l_wheel_Joint"/>
    <jointvel name="l_wheel_Joint_v" joint="l_wheel_Joint"/>
  </sensor>
</mujoco>
